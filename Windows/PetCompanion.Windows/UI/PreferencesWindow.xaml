<Window x:Class="PetCompanion.Windows.UI.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="萌宠陪伴设置"
        Width="380"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Top">
        <TextBlock Text="移动速度" FontWeight="SemiBold" />
        <DockPanel Margin="0,8,0,18">
            <TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right" Width="70" TextAlignment="Right" />
            <Slider x:Name="SpeedSlider" Minimum="30" Maximum="180" TickFrequency="5" ValueChanged="OnSpeedChanged" />
        </DockPanel>

        <TextBlock Text="小猫大小" FontWeight="SemiBold" />
        <DockPanel Margin="0,8,0,18">
            <TextBlock x:Name="ScaleLabel" DockPanel.Dock="Right" Width="70" TextAlignment="Right" />
            <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.4" TickFrequency="0.05" ValueChanged="OnScaleChanged" />
        </DockPanel>

        <CheckBox x:Name="FullScreenCheckBox"
                  Content="在全屏空间显示小猫"
                  Margin="0,0,0,12"
                  Checked="OnFullScreenChanged"
                  Unchecked="OnFullScreenChanged" />

        <CheckBox x:Name="LaunchAtLoginCheckBox"
                  Content="开机自动启动"
                  Margin="0,0,0,12"
                  Checked="OnLaunchAtLoginChanged"
                  Unchecked="OnLaunchAtLoginChanged" />

        <TextBlock x:Name="LoginStatusLabel"
                   FontSize="12"
                   Foreground="#666666"
                   TextWrapping="Wrap" />
    </StackPanel>
</Window>
